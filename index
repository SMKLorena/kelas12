    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
          background: linear-gradient(180deg, #b9deed 0%, #efefef 40%, #ffffff 100%);
            background-attachment: fixed;
            color: #333333;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            min-height: 100vh;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
            margin-top: 10px;
        }

        header h1 {
           color: #1e4b70;
            font-size: 1.2rem; /* Diperkecil dari 2.3rem */
            margin-bottom: 3px;
            font-weight: 500;
        }

        header p {
           color: #556c81;
            font-size: 0.50rem; /* Diperkecil dari 1.1rem */
            font-weight: 300;
        }

        /* Grid untuk Kartu Mapel */
        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            width: 100%;
            max-width: 900px;
            padding: 10px;
        }

        /* Desain Kartu Mapel */
        .card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            padding: 20px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
	   
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.15);
        }

        .card h2 {
            font-size: 1.2rem;
            color: #1e4b70;
            margin-bottom: 8px;
        }

        .card p {
            font-size: 0.85rem;
            color: #666666;
            margin-bottom: 15px;
	    line-height: 1.4;
        }
	/* Label Jadwal Tanggal Ujian */
        .jadwal-tag {
            display: inline-block;
            background-color: #fff0f0;
            color: #d9534f;
            padding: 3px 8px; /* Diperkecil */
            border-radius: 20px;
            font-size: 0.75rem; /* Diperkecil dari 0.85rem */
            font-weight: 600;
            margin-bottom: 12px;
	}
        /* Desain Tombol */
        .btn-link {
            text-decoration: none;
            background: linear-gradient(135deg, #4fa3d1 0%, #1d6fa5 100%);
            color: white;
            padding: 10px 15px; /* Diperkecil dari 12px 20px */
            border-radius: 6px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem; /* Diperkecil dari 1rem */
            transition: all 0.3s ease;
            box-shadow: 0 3px 8px rgba(29, 111, 165, 0.25);
        }

        .btn-link:hover {
            background-color: #2980b9;
        }

        /* Variasi warna pudar untuk border atas kartu agar lebih menarik */
        .card-matematika { border: 2px solid #4fa3d1 !important; } 
        .card-PKN { border: 2px solid #4fa3d1 !important; } 
